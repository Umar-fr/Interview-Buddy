{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "InterviewBuddy",
  "version": "0.1.0",
  "identifier": "com.qambar.interviewbuddy",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "InterviewBuddy",
        "width": 760,
        "height": 420,
        "minWidth": 460,
        "minHeight": 260,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "resizable": true,
        "shadow": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; connect-src 'self' https://generativelanguage.googleapis.com https://huggingface.co"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Interview Buddy",
    "copyright": "Copyright © 2024 Interview Buddy",
    "category": "Productivity",
    "shortDescription": "AI-powered real-time interview assistant",
    "longDescription": "Interview Buddy is a real-time AI interview copilot with offline speech-to-text, screen capture, and intelligent answer generation powered by Gemini AI.",
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "",
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "displayLanguageSelector": false,
        "installMode": "currentUser",
        "languages": ["English"]
      }
    },
    "macOS": {
      "minimumSystemVersion": "12.3",
      "frameworks": [],
      "signingIdentity": null
    }
  }
}
